<?xml version="1.0" encoding="utf-8"?>
<layer-properties>
  <!-- sky130A layer view tuned for std-cell-texture visibility.
       Order matters: layers drawn last appear on top. We draw the
       densest layers (met1, li1) last so they dominate the visible
       texture in the std-cell region. -->

  <!-- diff (active) — fine-grain background, lightest navy -->
  <properties>
    <name>diff drawing</name>
    <source>65/20@1</source>
    <fill-color>#8A9AB8</fill-color>
    <frame-color>#8A9AB8</frame-color>
    <dither-pattern>I0</dither-pattern>
    <line-style>I0</line-style>
    <visible>true</visible>
    <transparent>false</transparent>
    <width>0</width>
    <marked>false</marked>
    <animation>0</animation>
    <xfill>false</xfill>
  </properties>

  <!-- poly — gate level, darker navy -->
  <properties>
    <name>poly drawing</name>
    <source>66/20@1</source>
    <fill-color>#2A3A58</fill-color>
    <frame-color>#2A3A58</frame-color>
    <dither-pattern>I0</dither-pattern>
    <line-style>I0</line-style>
    <visible>true</visible>
    <transparent>false</transparent>
    <width>0</width>
    <marked>false</marked>
    <animation>0</animation>
    <xfill>false</xfill>
  </properties>

  <!-- li1 (local interconnect) — densest layer, mid navy. Drawn
       above poly/diff so the std-cell row structure dominates. -->
  <properties>
    <name>li1 drawing</name>
    <source>67/20@1</source>
    <fill-color>#4A5A78</fill-color>
    <frame-color>#4A5A78</frame-color>
    <dither-pattern>I0</dither-pattern>
    <line-style>I0</line-style>
    <visible>true</visible>
    <transparent>false</transparent>
    <width>0</width>
    <marked>false</marked>
    <animation>0</animation>
    <xfill>false</xfill>
  </properties>

  <!-- met1 — lighter navy on top of li1. Reveals power rails / cell
       routing without flooding. -->
  <properties>
    <name>met1 drawing</name>
    <source>68/20@1</source>
    <fill-color>#6A7A98</fill-color>
    <frame-color>#6A7A98</frame-color>
    <dither-pattern>I0</dither-pattern>
    <line-style>I0</line-style>
    <visible>true</visible>
    <transparent>false</transparent>
    <width>0</width>
    <marked>false</marked>
    <animation>0</animation>
    <xfill>false</xfill>
  </properties>

  <!-- nwell HIDDEN (was producing the diagonal-hatch flood) -->
  <properties>
    <name>nwell drawing</name>
    <source>64/20@1</source>
    <visible>false</visible>
    <transparent>true</transparent>
    <fill-color>#FFFFFF</fill-color>
    <frame-color>#FFFFFF</frame-color>
  </properties>

  <!-- Upper metals HIDDEN (no flood) -->
  <properties>
    <name>met2 drawing</name>
    <source>69/20@1</source>
    <visible>false</visible>
    <transparent>true</transparent>
    <fill-color>#FFFFFF</fill-color>
    <frame-color>#FFFFFF</frame-color>
  </properties>
  <properties>
    <name>met3 drawing</name>
    <source>70/20@1</source>
    <visible>false</visible>
    <transparent>true</transparent>
    <fill-color>#FFFFFF</fill-color>
    <frame-color>#FFFFFF</frame-color>
  </properties>
  <properties>
    <name>met4 drawing</name>
    <source>71/20@1</source>
    <visible>false</visible>
    <transparent>true</transparent>
    <fill-color>#FFFFFF</fill-color>
    <frame-color>#FFFFFF</frame-color>
  </properties>
  <properties>
    <name>met5 drawing</name>
    <source>72/20@1</source>
    <visible>false</visible>
    <transparent>true</transparent>
    <fill-color>#FFFFFF</fill-color>
    <frame-color>#FFFFFF</frame-color>
  </properties>

  <!-- prBoundary as a dark-gray frame-only outline so macro/die
       boundaries are crisp. -->
  <properties>
    <name>prBoundary 235/4</name>
    <source>235/4@1</source>
    <fill-color>#FFFFFF</fill-color>
    <frame-color>#333333</frame-color>
    <dither-pattern>I22</dither-pattern>
    <line-style>I0</line-style>
    <visible>true</visible>
    <transparent>true</transparent>
    <width>1</width>
    <marked>false</marked>
    <animation>0</animation>
    <xfill>false</xfill>
  </properties>
  <properties>
    <name>prBoundary 235/0</name>
    <source>235/0@1</source>
    <fill-color>#FFFFFF</fill-color>
    <frame-color>#333333</frame-color>
    <dither-pattern>I22</dither-pattern>
    <line-style>I0</line-style>
    <visible>true</visible>
    <transparent>true</transparent>
    <width>1</width>
    <marked>false</marked>
    <animation>0</animation>
    <xfill>false</xfill>
  </properties>

  <!-- Catch-all for unspecified layers: hidden -->
  <properties>
    <name>* (other)</name>
    <source>*/*@*</source>
    <visible>false</visible>
  </properties>
</layer-properties>
