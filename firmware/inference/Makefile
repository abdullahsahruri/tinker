# =============================================================================
# Phase-4.5 BNN inference firmware build (14×14 grouped architecture).
#
# weights_14x14.h is required at compile time and is generated by
# scripts/weights_to_c.py --net 14x14. The driver scripts/run_soc_bnn.sh
# (re-)generates it before invoking make here.
# =============================================================================

CROSS    ?= riscv64-unknown-elf-
CC       := $(CROSS)gcc
OBJCOPY  := $(CROSS)objcopy
OBJDUMP  := $(CROSS)objdump

ARCH     := rv32i
ABI      := ilp32
CFLAGS   := -march=$(ARCH) -mabi=$(ABI) \
            -nostdlib -nostartfiles -ffreestanding \
            -Os -fno-pic -fno-builtin \
            -Wall -Wextra -mno-relax
LDFLAGS  := -march=$(ARCH) -mabi=$(ABI) \
            -nostdlib -nostartfiles -ffreestanding \
            -T linker.ld -Wl,--no-relax \
            -Wl,-Map=firmware.map

REPO_ROOT := $(realpath ../..)
BIN2HEX   := $(REPO_ROOT)/scripts/bin2hex.py

# Match wb_imem.v SIZE_BYTES (2 KB / 4 = 512 words; shrunk in Session 3E
# baseline rerun, see wb_imem.v header). Pad firmware.hex to this depth so
# $readmemh fully populates IMEM.
IMEM_WORDS := 512

OBJS := start.o main.o

.PHONY: all clean lst

all: firmware.hex

start.o: start.S
	$(CC) $(CFLAGS) -c $< -o $@

main.o: main.c weights_14x14.h
	$(CC) $(CFLAGS) -c $< -o $@

firmware.elf: $(OBJS) linker.ld
	$(CC) $(LDFLAGS) -o $@ $(OBJS)

firmware.bin: firmware.elf
	$(OBJCOPY) -O binary $< $@

firmware.hex: firmware.bin
	python3 $(BIN2HEX) $< $@ --pad-words=$(IMEM_WORDS)

lst: firmware.elf
	$(OBJDUMP) -d -S firmware.elf > firmware.lst

clean:
	rm -f $(OBJS) firmware.elf firmware.bin firmware.hex firmware.map firmware.lst
