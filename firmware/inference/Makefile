# =============================================================================
# Phase-3D BNN inference firmware build.
#
# Forked from firmware/smoke/Makefile (same RV32I toolchain knobs and bin→hex
# pipeline). The only structural difference: weights.h is required at compile
# time and is generated by scripts/weights_to_c.py. The convenience driver
# scripts/run_soc_bnn.sh (re-)generates weights.h before invoking make here.
# =============================================================================

CROSS    ?= riscv64-unknown-elf-
CC       := $(CROSS)gcc
OBJCOPY  := $(CROSS)objcopy
OBJDUMP  := $(CROSS)objdump

ARCH     := rv32i
ABI      := ilp32
CFLAGS   := -march=$(ARCH) -mabi=$(ABI) \
            -nostdlib -nostartfiles -ffreestanding \
            -Os -fno-pic -fno-builtin \
            -Wall -Wextra -mno-relax
LDFLAGS  := -march=$(ARCH) -mabi=$(ABI) \
            -nostdlib -nostartfiles -ffreestanding \
            -T linker.ld -Wl,--no-relax \
            -Wl,-Map=firmware.map

REPO_ROOT := $(realpath ../..)
BIN2HEX   := $(REPO_ROOT)/scripts/bin2hex.py

# Match wb_imem.v SIZE_BYTES (8 KB / 4 = 2048 words). Pad firmware.hex to
# this depth so $readmemh fully populates IMEM.
IMEM_WORDS := 2048

OBJS := start.o main.o

.PHONY: all clean lst

all: firmware.hex

start.o: start.S
	$(CC) $(CFLAGS) -c $< -o $@

main.o: main.c weights.h
	$(CC) $(CFLAGS) -c $< -o $@

firmware.elf: $(OBJS) linker.ld
	$(CC) $(LDFLAGS) -o $@ $(OBJS)

firmware.bin: firmware.elf
	$(OBJCOPY) -O binary $< $@

firmware.hex: firmware.bin
	python3 $(BIN2HEX) $< $@ --pad-words=$(IMEM_WORDS)

lst: firmware.elf
	$(OBJDUMP) -d -S firmware.elf > firmware.lst

clean:
	rm -f $(OBJS) firmware.elf firmware.bin firmware.hex firmware.map firmware.lst
