# Phase 2C reuses 2B/2B.5 post-route artifacts and only re-runs OpenSTA's
# power stage. The small text outputs (power.rpt, power.metrics.json) are
# the canonical session artifacts and ARE committed; the large per-run
# VCDs and the iverilog sim binaries are not. Per-test power testbenches
# under tb/phase2c/ are auto-generated, so omit them too.
!results/phase2c/runs/
!results/phase2c/runs/**/
!results/phase2c/runs/**/power.metrics.json
!results/phase2c/runs/**/power.rpt
results/phase2c/saif/
results/phase2c/logs/
tb/phase2c/

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*~

# PDK should never live in this repo
.volare/
pdk/

# Firmware build outputs (Phase 3C onward). Sources committed; artifacts not.
firmware/**/*.o
firmware/**/*.elf
firmware/**/*.bin
firmware/**/*.hex
firmware/**/*.map
firmware/**/*.lst

# Phase-3D MNIST raw IDX files — re-downloaded by scripts/train_bnn.py on
# first invocation; the trained-network artifacts (data/bnn_weights.{npz,pt}
# and data/bnn_test_set.npz) ARE committed.
data/mnist/
